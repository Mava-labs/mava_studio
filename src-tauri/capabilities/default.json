{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the singleton preview window (labelled \"preview\", see composables/usePreview.ts)",
  "windows": [
    "main",
    "preview*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create",
    "core:window:allow-set-focus",
    "core:event:default",
    "opener:default",
    "fs:default",
    "dialog:default",
    "store:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "D:/**"
        },
        {
          "path": "C:/**"
        },
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "D:/**"
        },
        {
          "path": "C:/**"
        },
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "D:/**"
        },
        {
          "path": "C:/**"
        },
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$TEMP/**" },
        { "path": "D:/**" },
        { "path": "C:/**" },
        { "path": "/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$TEMP/**"
        },
        {
          "path": "D:/**"
        },
        {
          "path": "C:/**"
        },
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "dialog:allow-save",
      "allow": [
        {
          "path": "D:/**"
        },
        {
          "path": "C:/**"
        },
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "dialog:allow-open",
      "allow": [
        {
          "path": "$APPDATA/*"
        }
      ]
    }
  ]
}